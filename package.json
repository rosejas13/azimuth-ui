{
  "name": "azimuth-ui",
  "version": "0.11.4",
  "description": "A configurable, accessible React component library. Theme-driven via a single ThemeProvider with CSS custom properties. Built with TypeScript and CSS Modules.",
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not op_mini all"
  ],
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./icons": {
      "import": {
        "types": "./dist/icons/index.d.ts",
        "default": "./dist/icons/index.js"
      },
      "require": {
        "types": "./dist/icons/index.d.cts",
        "default": "./dist/icons/index.cjs"
      }
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "storybook dev -p 6006",
    "demo": "vite demo --config demo/vite.config.ts",
    "build": "tsup && node scripts/inject-use-client.mjs && node scripts/build-css.mjs && rm -f dist/*.map",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "lint": "stylelint 'src/**/*.css' && eslint src/",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}'",
    "test": "NODE_OPTIONS='--no-warnings' vitest run",
    "test:watch": "vitest",
    "test:a11y": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "ci": "npm run verify && npm run test:a11y",
    "deadcode": "knip",
    "prepublishOnly": "npm run verify",
    "prepare": "husky"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@axe-core/react": "^4.11.3",
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^8.0.0",
    "@storybook/addon-essentials": "^8.0.0",
    "@storybook/addon-interactions": "^8.0.0",
    "@storybook/react": "^8.0.0",
    "@storybook/react-vite": "^8.0.0",
    "@storybook/test": "^8.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.0.0",
    "@types/culori": "4.0.1",
    "@types/node": "25.9.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^2.1.9",
    "culori": "4.0.2",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "9.1.7",
    "jsdom": "^29.1.1",
    "knip": "6.16.1",
    "lint-staged": "17.0.6",
    "prettier": "^3.8.3",
    "storybook": "^8.0.0",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.30.0",
    "vitest": "^2.0.0",
    "zod": "4.4.3"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/rosejas13"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ]
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "design-system",
    "theme",
    "accessible"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rosejas13/azimuth-ui.git"
  },
  "homepage": "https://github.com/rosejas13/azimuth-ui#readme",
  "bugs": {
    "url": "https://github.com/rosejas13/azimuth-ui/issues"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.26"
  }
}
